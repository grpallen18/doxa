{
  "display_information": {
    "name": "Doxa L3 Approvals",
    "description": "Human approval inbox for Doxa L3 mint and lead proposals"
  },
  "features": {
    "bot_user": {
      "display_name": "Doxa L3",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "channels:read",
        "groups:history",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://doxa-two.vercel.app/api/slack/events",
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://doxa-two.vercel.app/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
