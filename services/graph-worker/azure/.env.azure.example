# Copy to azure/.env.azure (gitignored). Used by deploy.ps1 for full create/update.
# Image-only redeploy (preserves secrets): az acr build + az containerapp update --image

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEO4J_URI=neo4j+s://YOUR_AURA_ID.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GRAPH_WORKER_ID=graph-worker-1
GRAPH_WORKER_POLL_INTERVAL_SEC=5
# Leave empty on first deploy (script generates). On redeploy, paste existing secret so Supabase stays in sync.
GRAPH_WORKER_SECRET=
PORT=8080
